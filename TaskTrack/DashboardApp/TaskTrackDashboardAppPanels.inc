void TaskTrackDashboardWindow::ToggleExpanded(const String& id){int i=expanded_panels_.Find(id);if(i>=0)expanded_panels_.Remove(i);else expanded_panels_.Add(id);RebuildPanels();}
void TaskTrackDashboardWindow::RefreshCurrent(bool force_view){if(!loaded_)return;TaskTrackDashboardDocument latest;String error;if(!TaskTrackDashboardLoad(dashboard_path_,latest,error)){footer_status_.SetText("Unable to refresh dashboard: "+error);return;}bool changed=latest.revision!=current_revision_;current_revision_=latest.revision;if(force_view||viewing_revision_==0){display_=pick(latest);viewing_revision_=0;selected_category_="All";expanded_panels_.Clear();RefreshHeader();RebuildCategoryChoices();RebuildRevisionChoices(0);RebuildPanels();}else if(changed){RebuildRevisionChoices(viewing_revision_);RefreshHeader();}}
void TaskTrackDashboardWindow::LoadRevision(int r){if(!loaded_||r<=0)return;TaskTrackDashboardDocument h;String path,error;if(!TaskTrackDashboardLoadRevision(display_.dashboard_id,store_root_,r,h,path,error)){footer_status_.SetText("Unable to load revision: "+error);return;}display_=pick(h);viewing_revision_=r;selected_category_="All";expanded_panels_.Clear();RefreshHeader();RebuildCategoryChoices();RebuildRevisionChoices(r);RebuildPanels();}
void TaskTrackDashboardWindow::CheckForUpdate(){if(!loaded_)return;TaskTrackDashboardDocument latest;String error;if(!TaskTrackDashboardLoad(dashboard_path_,latest,error)||latest.revision==current_revision_)return;current_revision_=latest.revision;if(viewing_revision_==0){display_=pick(latest);RefreshHeader();RebuildCategoryChoices();RebuildRevisionChoices(0);RebuildPanels();}else{RebuildRevisionChoices(viewing_revision_);RefreshHeader();}}
void TaskTrackDashboardWindow::SyncScrollContent(){if(laying_out_)return;laying_out_=true;scroll_.Layout();Rect vp=scroll_.GetViewportRect();int width=max(DPI(320),vp.GetWidth()-DPI(2));int vh=max(DPI(100),vp.GetHeight());panels_box_.SetRect(0,0,width,DPI(4096));panels_box_.Layout();int height=max(vh,panels_box_.GetContentSize().cy);panels_box_.SetRect(0,0,width,height);panels_box_.Layout();scroll_.Layout();laying_out_=false;}
void TaskTrackDashboardWindow::Layout(){TopWindow::Layout();root_.Layout();SyncScrollContent();}
