struct SelfTest{int passed=0;Vector<String> failures;void Check(bool c,const String& m){if(c)++passed;else failures.Add(m);}};
Value SampleDashboard(const String& id,int a,int b){ValueMap x;x.Add("id","milestone-a");x.Add("title","Foundation");x.Add("status","complete");x.Add("progress",a);ValueMap y;y.Add("id","milestone-b");y.Add("title","Integration");y.Add("status","blocked");y.Add("progress",b);y.Add("attention",true);ValueArray es;es.Add(x);es.Add(y);ValueMap p;p.Add("id","milestones");p.Add("type","timeline");p.Add("title","Milestones");p.Add("contributes_to_progress",true);p.Add("entries",es);ValueArray ps;ps.Add(p);ValueMap d;d.Add("dashboard_id",id);d.Add("project","DashboardSelfTest");d.Add("title","Dashboard MCP acceptance");d.Add("phase","Validation");d.Add("updated_by","selftest");d.Add("panels",ps);return d;}
void CleanupSelfTest(const String& root,const String& id){String current=TaskTrackDashboardMakePath(root,id);FileDelete(current);FileDelete(current+".bak");FileDelete(current+".tmp");FileDelete(AppendFileName(root,id+".tasktrack-dashboard.lock"));String rev=TaskTrackDashboardRevisionFolder(root,id);FindFile ff(AppendFileName(rev,"*"));while(ff){if(ff.IsFile())FileDelete(AppendFileName(rev,ff.GetName()));ff.Next();}DirectoryDelete(rev);DirectoryDelete(AppendFileName(root,"revisions"));DirectoryDelete(root);}
int RunSelfTest(){SelfTest st;bool has=false;ValueMap lr;lr.Add("jsonrpc","2.0");lr.Add("id",1);lr.Add("method","tools/list");lr.Add("params",ValueMap());String tools=AsJSON(HandleRequest(lr,has),false);ValueMap mm;mm.Add("io.modelcontextprotocol/protocolVersion",CURRENT_PROTOCOL);ValueMap mp;mp.Add("_meta",mm);ValueMap mr;mr.Add("jsonrpc","2.0");mr.Add("id",2);mr.Add("method","tools/list");mr.Add("params",mp);String modern=AsJSON(HandleRequest(mr,has),false);st.Check(modern.Find("\"resultType\":\"complete\"")>=0&&modern.Find("cacheScope")>=0,"modern tools/list metadata");ValueMap bm;bm.Add("io.modelcontextprotocol/protocolVersion","2026-01-01");ValueMap bp;bp.Add("_meta",bm);ValueMap br;br.Add("jsonrpc","2.0");br.Add("id",3);br.Add("method","tools/list");br.Add("params",bp);st.Check(AsJSON(HandleRequest(br,has),false).Find("-32022")>=0,"unsupported protocol");const char* names[]={"validate_dashboard","upsert_dashboard","get_dashboard","open_dashboard","list_dashboards","list_dashboard_revisions","get_dashboard_revision"};for(const char* n:names)st.Check(tools.Find(n)>=0,String("missing ")+n);String root=AppendFileName(GetFileFolder(GetExeFilePath()),"_tasktrack_dashboard_mcp_selftest"),id="dashboard-mcp-selftest";CleanupSelfTest(root,id);RealizeDirectory(root);String val=AsJSON(ExecuteTool("validate_dashboard",SampleDashboard(id,100,0),false),false);st.Check(val.Find("\"valid\":true")>=0,"validate");ValueMap ca;ca.Add("store_root",root);ca.Add("base_revision",0);ca.Add("dashboard",SampleDashboard(id,100,0));st.Check(AsJSON(ExecuteTool("upsert_dashboard",ca,false),false).Find("\"revision\":1")>=0,"create rev1");ValueMap ga;ga.Add("dashboard_id",id);ga.Add("store_root",root);ga.Add("include_panels",true);st.Check(AsJSON(ExecuteTool("get_dashboard",ga,false),false).Find("dashboard_version")>=0,"roundtrip get");ValueMap sa;sa.Add("store_root",root);sa.Add("base_revision",0);sa.Add("dashboard",SampleDashboard(id,100,50));st.Check(AsJSON(ExecuteTool("upsert_dashboard",sa,false),false).Find("REVISION_CONFLICT")>=0,"stale conflict");ValueMap ua;ua.Add("store_root",root);ua.Add("base_revision",1);ua.Add("dashboard",SampleDashboard(id,100,50));st.Check(AsJSON(ExecuteTool("upsert_dashboard",ua,false),false).Find("\"revision\":2")>=0,"rev2");TaskTrackDashboardDocument cur;String e;st.Check(TaskTrackDashboardLoad(TaskTrackDashboardMakePath(root,id),cur,e)&&cur.revision==2,"current rev2");st.Check(fabs(TaskTrackDashboardDerivedProgress(cur)-75.0)<0.001,"progress");ValueArray revs;st.Check(TaskTrackDashboardListRevisions(id,root,10,revs,e)&&revs.GetCount()==2,"revision list");ValueMap ra;ra.Add("dashboard_id",id);ra.Add("store_root",root);ra.Add("revision",1);st.Check(AsJSON(ExecuteTool("get_dashboard_revision",ra,false),false).Find("Foundation")>=0,"revision get");ValueArray dashboards;st.Check(TaskTrackDashboardList(root,10,dashboards,e)&&dashboards.GetCount()==1,"dashboard list");CleanupSelfTest(root,id);if(st.failures.IsEmpty()){Cout()<<"tasktrack-dashboard-mcp-selftest: ok ("<<st.passed<<" checks)\n";return 0;}for(const String& f:st.failures)Cout()<<" - "<<f<<"\n";return 1;}
String HelpText(){return "TaskTrack Dashboard MCP\nSemantic project-state dashboard server for AI workflows.\n\nUsage:\n  TaskTrackDashboardMcp.exe\n  TaskTrackDashboardMcp.exe --version\n  TaskTrackDashboardMcp.exe --selftest\n  TaskTrackDashboardMcp.exe --oneshot <request.json>\n  TaskTrackDashboardMcp.exe --help\n";}
