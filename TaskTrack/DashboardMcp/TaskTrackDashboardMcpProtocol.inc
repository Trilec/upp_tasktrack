Value BuildDiscoverResult(){ValueArray v;v.Add(CURRENT_PROTOCOL);ValueMap c;c.Add("tools",ValueMap());ValueMap r;r.Add("resultType","complete");r.Add("supportedVersions",v);r.Add("capabilities",c);r.Add("instructions","Dashboard state is agent-authored presentation, not human evidence. Read current before update; use base_revision; retry WRITE_BUSY without bypassing the writer lock.");r.Add("ttlMs",300000);r.Add("cacheScope","public");AddModernMeta(r);return r;}
Value BuildLegacyInitialize(const Value& params){String requested=ReadString(params,"protocolVersion","2025-11-25");ValueMap tools;tools.Add("listChanged",false);ValueMap caps;caps.Add("tools",tools);ValueMap r;r.Add("protocolVersion",requested);r.Add("capabilities",caps);r.Add("serverInfo",ServerInfoValue());r.Add("instructions","Read get_dashboard before upsert_dashboard; existing dashboards require current base_revision.");return r;}
Value HandleRequest(const Value& request,bool& has){has=false;if(!request.Is<ValueMap>()){has=true;return JsonRpcError(Value(),-32600,"Invalid Request");}Value mv=request["method"];if(IsNull(mv)||!mv.Is<String>()){has=true;return JsonRpcError(request["id"],-32600,"Invalid Request");}String method=AsString(mv);Value id=request["id"];bool hid=!IsNull(id);if(method=="notifications/initialized")return Value();String protocol=RequestProtocol(request);if(!protocol.IsEmpty()&&protocol!=CURRENT_PROTOCOL){if(!hid)return Value();has=true;return JsonRpcError(id,-32022,"Unsupported protocol version");}if(method=="server/discover"){if(hid){has=true;return JsonRpcResult(id,BuildDiscoverResult());}return Value();}if(method=="initialize"){if(hid){Value p=request["params"];if(!p.Is<ValueMap>())p=ValueMap();has=true;return JsonRpcResult(id,BuildLegacyInitialize(p));}return Value();}if(method=="ping"){if(hid){ValueMap r;if(IsModern(request)){r.Add("resultType","complete");AddModernMeta(r);}has=true;return JsonRpcResult(id,r);}return Value();}if(method=="tools/list"){if(hid){has=true;return JsonRpcResult(id,BuildToolsList(IsModern(request)));}return Value();}if(method=="tools/call"){if(!hid)return Value();Value p=request["params"];if(!p.Is<ValueMap>()){has=true;return JsonRpcError(id,-32602,"Invalid params");}Value n=p["name"];Value a=p["arguments"];if(IsNull(a))a=ValueMap();if(IsNull(n)||!n.Is<String>()||!a.Is<ValueMap>()){has=true;return JsonRpcError(id,-32602,"Invalid tool call");}has=true;return JsonRpcResult(id,ExecuteTool(AsString(n),a,IsModern(request)));}if(hid){has=true;return JsonRpcError(id,-32601,"Method not found");}return Value();}
bool ProcessMessage(const String& msg,String& response,bool& has){response.Clear();has=false;Value request;try{request=ParseJSON(msg);}catch(CParser::Error){has=true;response=AsJSON(JsonRpcError(Value(),-32700,"Parse error"),false);return false;}Value result=HandleRequest(request,has);if(has)response=AsJSON(result,false);return true;}
bool ReadMessage(String& msg,bool& eof,String& error){msg.Clear();eof=false;error.Clear();for(;;){int ch=fgetc(stdin);if(ch==EOF){if(msg.IsEmpty()){eof=true;return false;}error="Unexpected EOF while reading MCP message.";return false;}if(ch=='\n')return true;if(ch!='\r')msg.Cat((char)ch);if(msg.GetCount()>16*1024*1024){error="MCP message exceeded 16 MB.";return false;}}}
void WriteMessage(const String& msg){fwrite(~msg,1,msg.GetLength(),stdout);fputc('\n',stdout);fflush(stdout);}
int RunServer(){for(;;){String m,e;bool eof=false;if(!ReadMessage(m,eof,e)){if(eof)return 0;WriteMessage(AsJSON(JsonRpcError(Value(),-32700,e),false));return 1;}String r;bool has=false;ProcessMessage(m,r,has);if(has)WriteMessage(r);}}
int RunOneShot(const String& f){String q=LoadFile(f);if(IsNull(q))return 1;String r;bool has=false;ProcessMessage(q,r,has);if(!has)return 1;WriteMessage(r);return 0;}
