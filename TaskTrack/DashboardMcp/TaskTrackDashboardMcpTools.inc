bool LaunchDashboardGui(const String& path,String& error){String exe="TaskTrackDashboardGui";
#ifdef PLATFORM_WIN32
exe<<".exe";
#endif
String gui=AppendFileName(GetFileFolder(GetExeFilePath()),exe);if(!FileExists(gui)){error="TaskTrack dashboard GUI executable not found beside MCP server: "+gui;return false;}Vector<String> a;a.Add("--dashboard");a.Add(path);LocalProcess p;
