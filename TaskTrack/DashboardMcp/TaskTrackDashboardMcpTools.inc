bool ResolveAndLoad(const Value& args,TaskTrackDashboardDocument& doc,String& path,String& error){if(!args.Is<ValueMap>()){error="arguments must be an object.";return false;}Value id=args["dashboard_id"],store=args["store_root"];if(IsNull(id)||!id.Is<String>()){error="dashboard_id is required and must be a string.";return false;}if(!IsNull(store)&&!store.Is<String>()){error="store_root must be a string.";return false;}if(!TaskTrackDashboardResolvePath(AsString(id),IsNull(store)?String():AsString(store),path,error))return false;return TaskTrackDashboardLoad(path,doc,error);}
