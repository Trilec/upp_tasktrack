TaskTrackDashboardStatusValue(d,p,inc),false,modern);}if(name=="open_dashboard"){TaskTrackDashboardDocument d;String p,e;if(!ResolveAndLoad(args,d,p,e))return BuildCallToolResult(Failure("DASHBOARD_NOT_FOUND",e),true,modern);bool launched=LaunchDashboardGui(p,e);ValueMap o=TaskTrackDashboardStatusValue(d,p,false);o.Add("launched",launched);if(!launched)o.Add("launch_error",e);return BuildCallToolResult(o,!launched,modern);}if(name=="list_dashboards"){if(!args.Is<ValueMap>())return BuildCallToolResult(Failure("BAD_REQUEST","arguments must be an object."),true,modern);Value store=args["store_root"];int limit=20;String e;if(!ReadInt(args,"limit",20,limit,e)||limit<1||limit>200)return BuildCallToolResult(Failure("BAD_REQUEST",e.IsEmpty()?String("limit must be 1..200."):e),true,modern);ValueArray a;if(!TaskTrackDashboardList(IsNull(store)?String():AsString(store),limit,a,e))return BuildCallToolResult(Failure("LIST_FAILED",e),true,modern);ValueMap o;o.Add("ok",true);o.Add("dashboards",a);return BuildCallToolResult(o,false,modern);}if(name=="list_dashboard_revisions"){Value id=args["dashboard_id"],store=args["store_root"];int limit=50;String e;if(IsNull(id)||!id.Is<String>()||!ReadInt(args,"limit",50,limit,e))return BuildCallToolResult(Failure("BAD_REQUEST","dashboard_id and valid limit are required."),true,modern);ValueArray a;if(!TaskTrackDashboardListRevisions(AsString(id),IsNull(store)?String():AsString(store),limit,a,e))return BuildCallToolResult(Failure("LIST_FAILED",e),true,modern);ValueMap o;o.Add("ok",true);o.Add("dashboard_id",AsString(id));o.Add("revisions",a);return BuildCallToolResult(o,false,modern);}if(name=="get_dashboard_revision"){Value id=args["dashboard_id"],store=args["store_root"];int r=0;String e;if(IsNull(id)||!id.Is<String>()||!ReadInt(args,"revision",0,r,e)||r<=0)return BuildCallToolResult(Failure("BAD_REQUEST","dashboard_id and positive revision are required."),true,modern);TaskTrackDashboardDocument d;String p;if(!TaskTrackDashboardLoadRevision(