Value DashboardEntrySchema(){ValueMap p;p.Add("id",StringSchema("Globally stable entry id."));p.Add("title",StringSchema("Short human-readable entry title."));p.Add("subtitle",StringSchema());p.Add("status",StringSchema());p.Add("detail",StringSchema());p.Add("category",StringSchema());p.Add("progress",NumberSchema("Optional 0..100 completion."));p.Add("weight",NumberSchema("Positive progress weight."));p.Add("attention",BoolSchema());p.Add("archived",BoolSchema());p.Add("timestamp",StringSchema());p.Add("task_id",StringSchema("Optional related normal TaskTrack decision task."));p.Add("evidence",StringSchema());p.Add("data",ValueMap());ValueArray req;req.Add("id");req.Add("title");ValueMap s;s.Add("type","object");s.Add("required",req);s.Add("properties",p);s.Add("additionalProperties",false);return s;}
Value DashboardPanelSchema(){const char* types[]={"project_state","timeline","progress_list","action_list","attention","verification","changes","records"};const char* densities[]={"summary","standard","full"};ValueMap p;p.Add("id",StringSchema());p.Add("type",EnumStringSchema(types,8,"Semantic dashboard panel renderer."));p.Add("title",StringSchema());p.Add("subtitle",StringSchema());p.Add("category",StringSchema());p.Add("density",EnumStringSchema(densities,3,"Initial detail density."));p.Add("preview_limit",IntSchema(1,100));p.Add("contributes_to_progress",BoolSchema());ValueMap entries;entries.Add("type","array");entries.Add("maxItems",TASKTRACK_DASHBOARD_MAX_ENTRIES_PER_PANEL);entries.Add("items",DashboardEntrySchema());p.Add("entries",entries);ValueArray req;req.Add("id");req.Add("type");req.Add("title");req.Add("entries");ValueMap s;s.Add("type","object");s.Add("required",req);s.Add("properties",p);s.Add("additionalProperties",false);return s;}
Value DashboardDocumentSchema(){ValueMap p;p.Add("schema_version",IntSchema(1,1));p.Add("dashboard_version",StringSchema("Server-produced marker; safe to round-trip."));p.Add("dashboard_id",StringSchema("Stable id beginning dashboard-."));p.Add("project",StringSchema());p.Add("title",StringSchema());p.Add("subtitle",StringSchema());p.Add("phase",StringSchema());p.Add("overall_progress",NumberSchema());p.Add("confidence",NumberSchema());p.Add("revision",IntSchema(0,INT_MAX,"Server-produced revision; upsert allocates next revision."));p.Add("created_at",StringSchema("Server-produced; safe to round-trip."));p.Add("updated_at",StringSchema("Server-produced; replaced on accepted write."));p.Add("updated_by",StringSchema());p.Add("source_head",StringSchema());ValueMap panels;panels.Add("type","array");panels.Add("minItems",1);panels.Add("maxItems",TASKTRACK_DASHBOARD_MAX_PANELS);panels.Add("items",DashboardPanelSchema());p.Add("panels",panels);ValueArray req;req.Add("title");req.Add("panels");ValueMap s;s.Add("type","object");s.Add("required",req);s.Add("properties",p);s.Add("additionalProperties",false);return s;}
Value UpsertSchema(){ValueMap p;p.Add("store_root",StringSchema());p.Add("base_revision",IntSchema(0,INT_MAX,"Required for existing dashboard; exact current revision."));p.Add("dashboard",DashboardDocumentSchema());ValueArray req;req.Add("dashboard");ValueMap s;s.Add("type","object");s.Add("required",req);s.Add("properties",p);s.Add("additionalProperties",false);return s;}
Value LocatorSchema(bool panels=false){ValueMap p;p.Add("dashboard_id",StringSchema());p.Add("store_root",StringSchema());if(panels)p.Add("include_panels",BoolSchema());ValueArray req;req.Add("dashboard_id");ValueMap s;s.Add("type","object");s.Add("required",req);s.Add("properties",p);s.Add("additionalProperties",false);return s;}
Value RevisionSchema(bool limit,bool revision){ValueMap p;p.Add("dashboard_id",StringSchema());p.Add("store_root",StringSchema());if(limit)p.Add("limit",IntSchema(1,500));if(revision)p.Add("revision",IntSchema(1,INT_MAX));ValueArray req;req.Add("dashboard_id");if(revision)req.Add("revision");ValueMap s;s.Add("type","object");s.Add("required",req);s.Add("properties",p);s.Add("additionalProperties",false);return s;}
Value BuildToolsList(bool modern){ValueArray tools;tools.Add(ToolSpec("version","Return dashboard service/schema versions.",EmptyObjectSchema(),true,false,true));tools.Add(ToolSpec("validate_dashboard","Validate a semantic dashboard without persisting it.",DashboardDocumentSchema(),true,false,true));tools.Add(ToolSpec("upsert_dashboard","Create/update current project dashboard and append immutable revision. Read current first; existing dashboards require exact base_revision. WRITE_BUSY is retryable and writer locks must not be bypassed.",UpsertSchema(),false,false,false));tools.Add(ToolSpec("get_dashboard","Read current dashboard and progress/attention summaries.",LocatorSchema(true),true,false,true));tools.Add(ToolSpec("open_dashboard","Open native read-only dashboard viewer.",LocatorSchema(),false,false,false));ValueMap lp;lp.Add("store_root",StringSchema());lp.Add("limit",IntSchema(1,200));ValueMap ls;ls.Add("type","object");ls.Add("properties",lp);ls.Add("additionalProperties",false);tools.Add(ToolSpec("list_dashboards","List current dashboards.",ls,true,false,true));tools.Add(ToolSpec("list_dashboard_revisions","List immutable revision summaries.",RevisionSchema(true,false),true,false,true));tools.Add(ToolSpec("get_dashboard_revision","Read immutable historical revision.",RevisionSchema(false,true),true,false,true));ValueMap r;if(modern)r.Add("resultType","complete");r.Add("tools",tools);if(modern){r.Add("ttlMs",300000);r.Add("cacheScope","public");AddModernMeta(r);}return r;}
