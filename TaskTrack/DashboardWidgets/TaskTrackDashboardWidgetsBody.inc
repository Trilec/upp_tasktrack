TaskTrackDashboardBodyCtrl::TaskTrackDashboardBodyCtrl(){Transparent();}
TaskTrackDashboardBodyCtrl& TaskTrackDashboardBodyCtrl::Bind(const TaskTrackDashboardPanel& p,bool e){panel_=&p;expanded_=e;RefreshLayout();Refresh();return *this;}
TaskTrackDashboardBodyCtrl& TaskTrackDashboardBodyCtrl::SetExpanded(bool e){if(expanded_!=e){expanded_=e;RefreshLayout();Refresh();}return *this;}
int TaskTrackDashboardBodyCtrl::VisibleCount() const { if(!panel_)return 0;if(expanded_||panel_->density==TaskTrackDashboardDensity::Full)return panel_->entries.GetCount();return min(panel_->entries.GetCount(),panel_->preview_limit);}
int TaskTrackDashboardBodyCtrl::RowHeight() const {if(!panel_)return DPI(30);if(expanded_||panel_->density==TaskTrackDashboardDensity::Full)return DPI(62);if(panel_->density==TaskTrackDashboardDensity::Summary)return DPI(27);return DPI(42);}
Size TaskTrackDashboardBodyCtrl::GetMinSize() const {int c=VisibleCount();int h=max(DPI(30),c*RowHeight());if(panel_&&!expanded_&&panel_->entries.GetCount()>c)h+=DPI(24);return Size(DPI(260),h);}
String TaskTrackDashboardBodyCtrl::FitText(const String& text,Font font,int mw) const {if(mw<=DPI(16)||GetTextSize(text,font).cx<=mw)return text;String out=text;while(out.GetCount()>3&&GetTextSize(out+"…",font).cx>mw)out=out.Left(out.GetCount()-2);return out+"…";}
Color TaskTrackDashboardBodyCtrl::StatusColor(const String& st,bool att) const {if(att||IsBlockedStatus(st))return Color(190,70,60);if(IsWarningStatus(st))return Color(190,130,45);if(IsCompletionStatus(st))return Color(45,142,77);if(IsActiveStatus(st))return SColorHighlight();String s=ToLower(TrimBoth(st));if(s=="next"||s=="planned"||s=="pending"||s=="queued")return Blend(SColorHighlight(),SColorPaper(),110);return SColorDisabled();}
void TaskTrackDashboardBodyCtrl::Paint(Draw& w)
{
    if(!panel_)return;int count=VisibleCount(),rh=RowHeight(),width=GetSize().cx,inset=DPI(4);Font tf=SansSerifZ(9).Bold(),bf=SansSerifZ(8),sf=SansSerifZ(7);Color div=Blend(SColorShadow(),SColorPaper(),130);
    for(int i=0;i<count;++i){const auto& e=panel_->entries[i];int y=i*rh;if(i>0)w.DrawLine(inset,y,max(inset,width-inset),y,DPI(1),div);Color status=StatusColor(e.status,e.attention);int marker=DPI(7),my=y+DPI(10);w.DrawEllipse(inset,my,marker,marker,status);int x=inset+marker+DPI(7),reserve=e.progress>=0?DPI(112):DPI(12),tw=max(DPI(40),width-x-reserve);String title=e.title;if(panel_->type==TaskTrackDashboardPanelType::ActionList)title=Format("%d. %s",i+1,e.title);w.DrawText(x,y+DPI(5),FitText(title,tf,tw),tf,SColorText());String second=e.subtitle;if(second.IsEmpty())second=e.status;if(!second.IsEmpty())w.DrawText(x,y+DPI(20),FitText(second,bf,tw),bf,SColorDisabled());if(e.progress>=0){int bl=max(x+DPI(40),width-DPI(105)),bt=y+DPI(8),bw=max(DPI(44),width-bl-DPI(6));w.DrawRect(bl,bt,bw,DPI(5),Blend(SColorShadow(),SColorPaper(),150));w.DrawRect(bl,bt,(int)(bw*minmax(e.progress,0.0,100.0)/100.0),DPI(5),status);w.DrawText(bl,bt+DPI(8),PercentText(e.progress),sf,SColorDisabled());}
        if(expanded_||panel_->density==TaskTrackDashboardDensity::Full){String detail=e.detail;auto append=[&](const String& v){if(v.IsEmpty())return;if(!detail.IsEmpty())detail<<" · ";detail<<v;};append(e.evidence);append(e.timestamp);if(!e.task_id.IsEmpty())append("Task "+e.task_id);if(!IsNull(e.data)){String d=e.data.Is<ValueMap>()||e.data.Is<ValueArray>()?AsJSON(e.data,false):AsString(e.data);append(d);}if(!detail.IsEmpty())w.DrawText(x,y+DPI(36),FitText(detail,sf,max(DPI(40),width-x-DPI(10))),sf,SColorText());}
    }
    if(!expanded_&&panel_->entries.GetCount()>count){int y=count*rh+DPI(5);w.DrawText(inset,y,Format("+ %d more · double-click this panel for full detail",panel_->entries.GetCount()-count),SansSerifZ(8),SColorDisabled());}
}
void TaskTrackDashboardBodyCtrl::LeftDouble(Point,dword){WhenToggleExpanded();}
